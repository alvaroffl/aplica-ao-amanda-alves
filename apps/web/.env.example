# Front-end (Vite). Valores públicos — nunca coloque segredos aqui.
# Local: copie para apps/web/.env.local (os valores abaixo são os do `supabase start`).
VITE_APP_NAME=Amanda Alves
# URL da API do Supabase. "/supabase" usa o proxy do Vite (mesma origem), o que
# permite abrir pelo celular na rede local. Em produção: https://<ref>.supabase.co
VITE_SUPABASE_URL=/supabase
# Chave publicável (sb_publishable_...) ou anon key legada
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Cloudflare Turnstile (vazio = sem captcha, apenas em desenvolvimento).
# Chave de teste que sempre passa: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
# Pagamentos: "test" (padrão, sandbox — o app mostra o aviso de modo de teste) | "live"
VITE_PAYMENTS_MODE=test
# Texto do botão flutuante de WhatsApp na página pública
VITE_WHATSAPP_CTA=Falar com a Amanda
# Página de agendamento da clínica (slug do negócio no banco)
VITE_CLINIC_SLUG=amanda-alves

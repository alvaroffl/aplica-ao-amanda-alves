# Variáveis das Edge Functions.
# Local:     copie para supabase/functions/.env  (lido por `supabase functions serve`)
# Produção:  supabase secrets set --env-file supabase/functions/.env.production
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo Supabase.

# production ativa as travas (captcha obrigatório, sem provedor fake)
ENVIRONMENT=development
APP_NAME=Amanda Alves
# URL pública do front-end (links em e-mails/WhatsApp)
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# usado no notification_url do Mercado Pago
FUNCTIONS_PUBLIC_URL=http://127.0.0.1:54321/functions/v1

# Proteção contra abuso
# Cloudflare Turnstile (vazio = captcha desligado em dev)
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=troque-este-valor
# Limites da reserva pública
BOOKING_LIMIT_IP_PER_MINUTE=10
BOOKING_LIMIT_IP_PER_HOUR=40
BOOKING_LIMIT_EMAIL_PER_HOUR=8

# Worker (pg_cron → process-queue). Deve ser igual ao segredo "worker_secret" no Vault.
WORKER_SECRET=local-worker-secret

# Pagamentos: fake (dev) | mercadopago
PAYMENTS_PROVIDER=fake
# test (padrão) = sandbox: cobranças marcadas como teste e aviso no app | live = produção
PAYMENTS_MODE=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail: log | mailpit (dev, http://127.0.0.1:54324) | resend
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Amanda Alves <nao-responda@amandaalvespmu.com.br>
RESEND_API_KEY=
MAILPIT_URL=http://inbucket:8025

# WhatsApp: log | meta (Cloud API oficial)
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=pt_BR

-- Todos os dias, 09:00–12:00 e 13:00–18:00 (pausa de almoço), hora local da unidade.
insert into public.availability_rules (business_id, professional_id, unit_id, weekday, start_time, end_time)
select pu.business_id, pu.professional_id, pu.unit_id, wd, t.s, t.e
from public.professional_units pu
cross join generate_series(0, 6) wd
cross join (values (time '09:00', time '12:00'), (time '13:00', time '18:00')) t(s, e)
where pu.business_id in ('10000000-0000-0000-0000-00000000000a', '10000000-0000-0000-0000-00000000000b');

-- Dia de teste: segunda-feira daqui a 8–14 dias (longe de antecedência mínima/máxima).
create function pg_temp.test_day() returns date language sql stable as $$
  select current_date + (8 - extract(isodow from current_date)::int) + 7
$$;

-- Converte hora local (São Paulo) do dia de teste em timestamptz.
create function pg_temp.at_local(t time, tz text default 'America/Sao_Paulo') returns timestamptz language sql stable as $$
  select (pg_temp.test_day() + t) at time zone tz
$$;

-- Simula um usuário autenticado (use junto com: set local role authenticated)
create function pg_temp.login(uid uuid) returns void language sql as $$
  select set_config('request.jwt.claims', json_build_object('sub', uid, 'role', 'authenticated')::text, true);
$$;
grant execute on function pg_temp.login(uuid) to public;
grant execute on function pg_temp.test_day() to public;
grant execute on function pg_temp.at_local(time, text) to public;

-- Atalho para criar reservas públicas
create function pg_temp.book(
  p_service uuid, p_pro uuid, p_at timestamptz, p_email text, p_key uuid default gen_random_uuid(),
  p_unit uuid default '20000000-0000-0000-0000-00000000000a'
) returns jsonb language sql as $$
  select public.create_booking(p_service, p_unit, p_pro, p_at, 'Cliente Teste', p_email, '+5511999990000', null, p_key, 'v1')
$$;
